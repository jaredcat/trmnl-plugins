{% assign chart_id = "rating_1" | append_random %}
<div class="layout layout--col portrait:layout--top">
{% if dealInfo %}
  <div class="item">
    <div class="content gap--xsmall">
      <span class="title" data-clamp="1">{{ dealInfo.title }}</span>
      <div class="flex flex--row gap--xsmall flex--center-y">
        <img class="image w--5 h--5" src="{{ dealInfo.storeIconUrl }}" alt="" aria-hidden="true">
        <span class="label">{{ dealInfo.storeName }}</span>
      </div>
    </div>
  </div>

  <div class="flex flex--row w--full gap--small">
    <div class="w--[34cqw] w--min-0">
      <img class="image image-dither image--contain w--full h--20" src="{{ dealInfo.thumb }}" alt="">
    </div>
    <div class="w--[33cqw] w--min-0 portrait:hidden lg:portrait:block">
      <div id="{{ chart_id }}" class="w--full h--16"></div>
      {{ steam_rating_label }}
    </div>
    <div class="w--[33cqw] w--min-0 portrait:w--[66cqw] lg:portrait:w--[33cqw]">
      <span class="value value--large portrait:value--small lg:portrait:value--large value--tnums" data-fit-value="true">{{ dealInfo.salePrice | default 0 | number_to_currency }}</span>

      <div class="grid">
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--small value--tnums " data-fit-value="true">{{ dealInfo.savings | default 0 | round }}% off</span>
            <span class="label">Was {{ dealInfo.normalPrice | default 0 | number_to_currency }}</span>
          </div>
        </div>
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--small value--tnums" data-fit-value="true">{{ dealInfo.dealRating | default 0 | round }}/10</span>
            <span class="label">Deal rating</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>




<script type="text/javascript">
  let opts = {
    title: null,
    labels: { enabled: false },
    height: "50%",
    series: {
      fontSize: "16px",
      fontWeight: "400",
      fontFamily: "NicoClean"
    },
    yAxis: {
      title: null
    }
  }

  {% if dealInfo.steamRatingPercent == "0" %}
  createGauge({{ dealInfo.metacriticScore | default: 0 }}, "{{ chart_id }}", opts)
  {% else %}
  createGauge({{ dealInfo.steamRatingPercent | default: 0 }}, "{{ chart_id }}", opts)
  {% endif %}
</script>
{% else %}
  <div class="flex flex--col flex--center gap--small p--4">
    <span class="label">No deals match your filters.</span>
    <span class="label text--muted">{{ filteredCount }} of {{ totalDeals }} passed.</span>
  </div>
{% endif %}
</div>